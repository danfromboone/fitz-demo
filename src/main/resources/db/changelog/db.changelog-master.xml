<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="1" author="dan">
        <createTable tableName="foo">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="2" author="dan">
        <createTable tableName="goo">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="3" author="dan">
        <createTable tableName="authors">
            <column name="name" type="VARCHAR(255)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="4" author="dan">
        <createTable tableName="books">
            <column name="code" type="VARCHAR(64)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="title" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="5" author="dan">
        <createTable tableName="book_authors">
            <column name="book_code" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="author_name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="author_order" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addPrimaryKey tableName="book_authors" columnNames="book_code, author_name" constraintName="pk_book_authors"/>
        <addForeignKeyConstraint baseTableName="book_authors" baseColumnNames="book_code"
                                 referencedTableName="books" referencedColumnNames="code"
                                 constraintName="fk_book_authors_books" onDelete="CASCADE"/>
        <addForeignKeyConstraint baseTableName="book_authors" baseColumnNames="author_name"
                                 referencedTableName="authors" referencedColumnNames="name"
                                 constraintName="fk_book_authors_authors" onDelete="CASCADE"/>
    </changeSet>

</databaseChangeLog>
